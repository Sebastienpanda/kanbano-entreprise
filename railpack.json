{
    "$schema": "https://schema.railpack.com",

    "steps": {
        "install": {
            "copy": [
                { "src": ".", "dest": "/app" }
            ],
            "caches": {
                "pnpm-store": {
                    "directory": "/root/.pnpm-store",
                    "type": "shared"
                }
            },
            "commands": [
                "cd /app",
                "pnpm install --frozen-lockfile"
            ]
        },

        "build": {
            "inputs": [{ "step": "install" }],
            "commands": [
                "cd /app",
                "pnpm nx build newsletters --configuration=production",
                "pnpm prune --prod"
            ]
        }
    },

    "deploy": {
        "startCommand": "node dist/apps/newsletters/main.js"
    }
}
