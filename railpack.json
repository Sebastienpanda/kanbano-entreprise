{
    "$schema": "https://schema.railpack.com",

    "caches": {
        "pnpm-store": {
            "directory": "/root/.local/share/pnpm",
            "type": "shared"
        }
    },

    "steps": {
        "copy": {
            "src": ".",
            "dest": "/app"
        },

        "install": {
            "inputs": [{ "step": "copy" }],
            "commands": ["cd /app", "pnpm install --frozen-lockfile"],
            "caches": ["pnpm-store"]
        },

        "build": {
            "inputs": [{ "step": "install" }],
            "commands": [
                "cd /app",
                "pnpm nx build newsletters --configuration=production",
                "pnpm prune --prod"
            ]
        }
    },

    "deploy": {
        "startCommand": "cd /app && node dist/apps/newsletters/main.js"
    }
}
