{
    "$schema": "https://schema.railpack.com",
    "build": {
        "context": "."
    },
    "steps": {
        "install": {
            "commands": ["pnpm install"]
        },
        "build": {
            "inputs": [{ "step": "install" }],
            "commands": [
                "pnpm exec nx run kanbano:build --configuration=production"
            ]
        }
    },
    "deploy": {
        "startCommand": "npx serve dist/apps/kanbano/browser -s -n -p $PORT"
    }
}
