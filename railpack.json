{
    "$schema": "https://schema.railpack.com",

    "assets": [
        {
            "source": ".",
            "destination": "."
        }
    ],

    "caches": {
        "pnpm-store": {
            "directory": "/root/.local/share/pnpm/store",
            "type": "shared"
        }
    },

    "steps": {
        "install": {
            "commands": [
                "pnpm install --frozen-lockfile --prefer-offline"
            ]
        },

        "build": {
            "inputs": ["install"],
            "commands": [
                "pnpm nx build newsletters --prod --skip-nx-cache"
            ],
            "outputs": ["dist/apps/newsletters"]
        }
    },

    "deploy": {
        "startCommand": "node dist/apps/newsletters/main.js",
    }
}
