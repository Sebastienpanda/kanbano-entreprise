{
    "$schema": "https://schema.railpack.com",
    "copy": [
        {
            "source": ".",
            "destination": "."
        }
    ],
    "caches": {
        "pnpm-store": {
            "directory": "/root/.local/share/pnpm/store",
            "type": "shared"
        }
    },
    "steps": {
        "install": {
            "commands": [
                "pnpm install --frozen-lockfile --prefer-offline"
            ]
        },
        "build": {
            "inputs": ["install"],
            "commands": [
                "pnpm nx build newsletters --configuration=production"
            ],
            "outputs": ["dist/apps/newsletters"]
        }
    }
}
