{
    "$schema": "https://schema.railpack.com",

    "copy": [
        {
            "source": ".",
            "destination": "/app"
        }
    ],

    "caches": {
        "pnpm-store": {
            "directory": "/root/.local/share/pnpm/store",
            "type": "shared"
        }
    },

    "steps": {
        "install": {
            "commands": ["pnpm install --frozen-lockfile --prefer-offline"],
            "caches": ["pnpm-store"]
        },

        "build": {
            "inputs": ["install"],
            "commands": [
                "pnpm nx build newsletters --configuration=production"
            ],
            "outputs": ["dist/apps/newsletters"]
        }
    },

    "deploy": {
        "startCommand": "node dist/apps/newsletters/main.js"
    }
}
