{
    "$schema": "https://schema.railpack.com",
    "assets": [
        {
            "source": ".",
            "destination": "/app"
        }
    ],

    "caches": {
        "pnpm-store": {
            "directory": "/pnpm/store",
            "type": "shared"
        }
    },

    "steps": {
        "install": {
            "commands": [
                "pnpm install --frozen-lockfile --prefer-offline"
            ]
        },
        "build": {
            "inputs": [{ "step": "install" }],
            "commands": [
                "pnpm nx build newsletters --configuration=production"
            ]
        }
    },

    "deploy": {
        "startCommand": "node dist/apps/newsletters/main.js"
    }
}
